<reactiveUi:ReactiveUserControl
    x:TypeArguments="textEntry:ISettingTextEntryViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveUi="http://reactiveui.net"
    xmlns:textEntry="clr-namespace:NexusMods.App.UI.Controls.Settings.SettingEntries.TextEntry"
    mc:Ignorable="d"
    x:Class="NexusMods.App.UI.Controls.Settings.SettingEntries.TextEntry.SettingTextEntryControl">

    <TextBox x:Name="TextBox"
             TextWrapping="Wrap"
             HorizontalAlignment="Right"
             VerticalContentAlignment="Top"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />

</reactiveUi:ReactiveUserControl>
